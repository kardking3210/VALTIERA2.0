# Optional VALTIERA backend origin for authentication, research runs, and portfolio storage.
VITE_MARKET_DATA_API_URL=

# Optional read-only Alpaca IEX market data; keep on backend only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional FMP key for daily/weekly forex, commodity, and futures-symbol history.
FMP_API_KEY=
# Required by Docker Compose if using PostgreSQL services.
POSTGRES_PASSWORD=

ALPACA_PAPER_TRADING_ENABLED=false
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

ALPACA_PAPER_OWNER_EMAIL=your-local-account@example.com
